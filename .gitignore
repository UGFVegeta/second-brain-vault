# macOS
.DS_Store
.AppleDouble
.Trashes

# Obsidian – gerätespezifischer Arbeitscache (ändert sich ständig, kein echter Inhalt)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# temporäre / Sperr- / Sicherungsdateien
*.tmp
~$*
.~lock.*

# Log der Auto-Commit-Automatik
.scripts/git_autocommit.log

# Claude Code Tooling / Skills (reinstallierbar, teils eigene Git-Repos)
# Ausnahme: grill-me ist ein eigener Skill (kein Plugin) und wird mitversioniert
.claude/skills/*
!.claude/skills/grill-me/

# Claude Code lokale Settings mit API-Keys (nicht ins Repo)
.claude/settings.local.json

# Node
node_modules/

# Firecrawl-Cache (Scrape-/Parse-Ergebnisse, kein Vault-Inhalt)
.firecrawl/
