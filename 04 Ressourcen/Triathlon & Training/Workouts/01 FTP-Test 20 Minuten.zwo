<workout_file>
  <author>Oskar Klein</author>
  <name>FTP-Test 20 min</name>
  <description>Ausgangswert fuer den Winter. Die 20-Minuten-Leistung mal 0,95 ergibt die FTP. Gleichmaessig fahren, nicht anfangs ueberziehen.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.75">
      <textevent timeoffset="0" message="Einfahren, locker steigern"/>
    </Warmup>
    <IntervalsT Repeat="3" OnDuration="60" OffDuration="60" OnPower="1.05" OffPower="0.50">
      <textevent timeoffset="0" message="Drei Oeffner, kurz und knackig"/>
    </IntervalsT>
    <SteadyState Duration="300" Power="0.55"/>
    <SteadyState Duration="1200" Power="1.00">
      <textevent timeoffset="0" message="20 Minuten alles, was geht. Gleichmaessig!"/>
      <textevent timeoffset="300" message="5 min rum, Tempo halten"/>
      <textevent timeoffset="600" message="Halbzeit"/>
      <textevent timeoffset="900" message="Letzte 5 Minuten, jetzt zaehlt es"/>
    </SteadyState>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
